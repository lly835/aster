# Main/login wallet address. Do not put the main-wallet private key here.
ASTER_USER_ADDRESS=0xYourMainAccountAddress

# Aster Pro API Wallet / Agent address.
ASTER_SIGNER_ADDRESS=0xYourApiWalletAddress

# Private key belonging to ASTER_SIGNER_ADDRESS.
# Keep this file local; .env is ignored by Git.
ASTER_SIGNER_PRIVATE_KEY=0xYourApiWalletPrivateKey

RUST_LOG=info
